{
  "name": "printizer",
  "version": "1.0.0",
  "description": "PRINTIZER - Everything Your Business Needs to Print - Quotation & Printing Solutions",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev": "concurrently \"node server/server.js\" \"npm --prefix client run dev\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vercel": "^66.6.0"
  }
}
